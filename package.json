{
  "name": "uptimererer-cdk",
  "version": "1.0.0",
  "description": "AWS CDK deployment for uptimererer lambda",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy-localstack": "cdk deploy --context environment=localstack",
    "deploy-aws": "cdk deploy --context environment=aws",
    "destroy-localstack": "cdk destroy --context environment=localstack",
    "destroy-aws": "cdk destroy --context environment=aws"
  },
  "keywords": [
    "aws",
    "cdk",
    "lambda",
    "uptime-monitoring"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "20.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.239.0",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21",
    "cdk-nag": "^2.0.0"
  }
}
